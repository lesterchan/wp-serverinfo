<?xml version="1.0"?>
<ruleset name="WP-ServerInfo">
	<description>WordPress Coding Standards for WP-ServerInfo.</description>

	<file>.</file>

	<!-- WPCS has no JavaScript sniffs; never let PHPCS touch .js. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Scanning these makes the CI runner run out of memory. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<rule ref="WordPress"/>

	<config name="text_domain" value="wp-serverinfo"/>
	<config name="minimum_wp_version" value="6.0"/>

	<!-- The tests assert on the plugin's own markup, so they must not escape it. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		A test method's name is its documentation - test_lowercase_shorthand_
		size_is_parsed() gains nothing from a docblock repeating it. Required
		everywhere else.
	-->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Test files are named test-*.php by WordPress convention rather than
		class-*.php; the coding standard excepts test classes from that rule.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Several tests assert on the plugin's own source - that uninstall.php
		lifts the get_sites() cap, that the GD probe no longer scrapes
		phpinfo(). Those are invariants a single-site suite cannot reach any
		other way. file_get_contents() on a local path is the right tool;
		wp_remote_get() fetches over HTTP.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		test-php.php drives real ini values through the probes, because the
		bugs it guards were about a directive's value being misread. Setting
		them is the test.
	-->
	<rule ref="WordPress.PHP.IniSet">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		The whole plugin is live server introspection: SHOW VARIABLES, SHOW
		TABLE STATUS and SELECT VERSION() have no core API wrapper, and their
		results must not be cached or the panel reports stale figures. The
		production classes annotate each query individually; the tests query
		the server directly to build their expectations.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
